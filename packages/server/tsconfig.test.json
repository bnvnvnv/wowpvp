{
  // 主 tsconfig 把 **/*.test.ts 排除在外，否则测试会被编进 dist ——
  // 而 dist 里的**编译副本**会被 vitest 当成第二份测试再跑一遍。
  //
  // ★ 但「不编译」不等于「不检查」：测试文件不过类型检查时，从一个模块
  //   import 它并不导出的符号会得到 `undefined` 而不是报错，
  //   于是测试可能**因为错误的原因通过**。所以单独开一个 noEmit 项目检查它们。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": []
}
